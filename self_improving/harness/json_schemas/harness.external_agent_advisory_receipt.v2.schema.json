{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "GenesisFreshCaptureReceiptV1": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "observed_restored_final_pose",
          "title": "Authority",
          "type": "string"
        },
        "capture_result": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "process_continuation": {
          "const": false,
          "title": "Process Continuation",
          "type": "boolean"
        },
        "replay_receipt": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "replay_run_id": {
          "format": "uuid4",
          "title": "Replay Run Id",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "schema_version": {
          "const": "harness.genesis_fresh_capture_receipt.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "ttl_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Ttl Seconds",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "replay_run_id",
        "replay_receipt",
        "request",
        "capture_result",
        "image",
        "captured_at",
        "checked_at",
        "expires_at",
        "ttl_seconds",
        "authority",
        "process_continuation"
      ],
      "title": "GenesisFreshCaptureReceiptV1",
      "type": "object"
    },
    "ObservationCitationV2": {
      "additionalProperties": false,
      "description": "Self-contained exact citation; it does not authenticate the cited producer.",
      "properties": {
        "authority": {
          "const": "observed_restored_final_pose",
          "title": "Authority",
          "type": "string"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/GenesisFreshCaptureReceiptV1"
        },
        "process_continuation": {
          "const": false,
          "title": "Process Continuation",
          "type": "boolean"
        },
        "receipt": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "schema_version": {
          "const": "harness.observation_citation.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "ttl_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Ttl Seconds",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "receipt",
        "observation",
        "captured_at",
        "expires_at",
        "ttl_seconds",
        "authority",
        "process_continuation"
      ],
      "title": "ObservationCitationV2",
      "type": "object"
    }
  },
  "$id": "harness.external_agent_advisory_receipt.v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "advisory_kind": {
      "enum": [
        "visual_assessment",
        "diagnosis",
        "repair_proposal"
      ],
      "title": "Advisory Kind",
      "type": "string"
    },
    "authority": {
      "const": "advisory_only",
      "title": "Authority",
      "type": "string"
    },
    "base_revision": {
      "minimum": 0,
      "title": "Base Revision",
      "type": "integer"
    },
    "base_state": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "base_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Base State Sha256",
      "type": "string"
    },
    "base_turn_seq": {
      "minimum": 0,
      "title": "Base Turn Seq",
      "type": "integer"
    },
    "command": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "command_id": {
      "format": "uuid4",
      "title": "Command Id",
      "type": "string"
    },
    "committed_at": {
      "format": "date-time",
      "title": "Committed At",
      "type": "string"
    },
    "committed_revision": {
      "minimum": 1,
      "title": "Committed Revision",
      "type": "integer"
    },
    "committed_turn_seq": {
      "minimum": 1,
      "title": "Committed Turn Seq",
      "type": "integer"
    },
    "diagnostic_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Diagnostic Refs",
      "type": "array"
    },
    "disposition": {
      "enum": [
        "recommend",
        "abstain"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "external_agent_executed": {
      "const": false,
      "title": "External Agent Executed",
      "type": "boolean"
    },
    "failure_receipts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Failure Receipts",
      "type": "array"
    },
    "grants_physical_validity": {
      "const": false,
      "title": "Grants Physical Validity",
      "type": "boolean"
    },
    "grants_publishability": {
      "const": false,
      "title": "Grants Publishability",
      "type": "boolean"
    },
    "observation_citations": {
      "items": {
        "$ref": "#/$defs/ObservationCitationV2"
      },
      "title": "Observation Citations",
      "type": "array"
    },
    "predecessor_receipt": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "principal_id": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Principal Id",
      "type": "string"
    },
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Sha256",
      "type": "string"
    },
    "recommended_action": {
      "enum": [
        "none",
        "retry",
        "revise_prompt",
        "fallback_image",
        "repair_assets",
        "stop"
      ],
      "title": "Recommended Action",
      "type": "string"
    },
    "resource_access_receipts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Resource Access Receipts",
      "type": "array"
    },
    "resulting_state": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "resulting_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Resulting State Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "harness.external_agent_advisory_receipt.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_prompt": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "source_prompt_revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "workflow_run_id": {
      "format": "uuid4",
      "title": "Workflow Run Id",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "workflow_run_id",
    "principal_id",
    "command",
    "predecessor_receipt",
    "base_revision",
    "committed_revision",
    "base_turn_seq",
    "committed_turn_seq",
    "base_state_sha256",
    "base_state",
    "resulting_state_sha256",
    "resulting_state",
    "committed_at",
    "schema_version",
    "advisory_kind",
    "disposition",
    "summary",
    "recommended_action",
    "source_prompt",
    "source_prompt_revision",
    "failure_receipts",
    "observation_citations",
    "diagnostic_refs",
    "authority",
    "external_agent_executed",
    "grants_physical_validity",
    "grants_publishability",
    "receipt_sha256"
  ],
  "title": "ExternalAgentAdvisoryReceiptV2",
  "type": "object"
}
