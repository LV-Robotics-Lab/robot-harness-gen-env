{
  "$defs": {
    "ArtifactRef": {
      "$id": "harness.artifact_ref.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "harness.run_start_request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Create a parent workflow from immutable user-input evidence.",
  "properties": {
    "idempotency_key": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "initial_fact_evidence": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Initial Fact Evidence",
      "type": "array"
    },
    "principal_id": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Principal Id",
      "type": "string"
    },
    "registry_snapshot": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "requested_profile": {
      "maxLength": 255,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+@(?:0|[1-9][0-9]*)$",
      "title": "Requested Profile",
      "type": "string"
    },
    "schema_version": {
      "const": "harness.run_start_request.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "workspace": {
      "enum": [
        "ephemeral",
        "production"
      ],
      "title": "Workspace",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "principal_id",
    "idempotency_key",
    "workspace",
    "requested_profile",
    "initial_fact_evidence",
    "registry_snapshot"
  ],
  "title": "RunStartRequest",
  "type": "object"
}
