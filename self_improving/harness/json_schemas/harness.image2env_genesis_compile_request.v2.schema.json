          "maxItems": 256,
          "minItems": 1,
          "title": "Relations",
          "type": "array"
        },
        "route_id": {
          "enum": [
            "image2env",
            "video2env"
          ],
          "title": "Route Id",
          "type": "string"
        },
        "schema_version": {
          "const": "harness.scene_interpretation_proposal.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_media_sha256": {
          "pattern": "^[0-9a-f]{64}$",
