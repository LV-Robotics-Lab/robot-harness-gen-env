          "enum": [
            "on_table",
            "on_top_of",
            "inside",
            "near"
          ],
          "title": "Relation",
          "type": "string"
        },
        "source": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "pattern": "^(table|[a-z][a-z0-9_]{0,63})$",
