    "ProposedSceneObjectV1": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "dimensions_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Dimensions M",
          "type": "array"
        },
        "object_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Object Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "dynamic",
            "support_surface"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "category",
        "role",
        "dimensions_m"
      ],
