    "SceneInterpretationProposalV1": {
      "additionalProperties": false,
      "properties": {
        "effective_prompt": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/ProposedSceneObjectV1"
