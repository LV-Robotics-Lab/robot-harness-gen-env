{
  "$defs": {
    "ArtifactRef": {
      "$id": "harness.artifact_ref.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AssetAcquisitionLane": {
      "enum": [
        "environment_reuse",
        "exact_asset_reuse",
        "digital_cousin_reuse",
        "fresh_asset_generation"
      ],
      "title": "AssetAcquisitionLane",
      "type": "string"
    }
  },
  "$id": "harness.x2env_asset_decision.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision_evidence": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "digital_cousin_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "generation_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "lane": {
      "$ref": "#/$defs/AssetAcquisitionLane"
    },
    "object_id": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Object Id",
      "type": "string"
    },
    "schema_version": {
      "const": "harness.x2env_asset_decision.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "source_qualification": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "object_id",
    "lane",
    "selected_artifact",
    "decision_evidence",
    "source_qualification",
    "digital_cousin_evidence",
    "generation_receipt"
  ],
  "title": "X2EnvAssetDecision",
  "type": "object"
}
