{
  "$id": "harness.development_skill_descriptor.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Implementation Sha256",
      "type": "string"
    },
    "input_schema": {
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+\\.v(?:0|[1-9][0-9]*)$",
      "title": "Input Schema",
      "type": "string"
    },
    "max_attempts": {
      "default": 1,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "mcp_tool_name": {
      "pattern": "^[a-z][a-z0-9_]{0,127}$",
      "title": "Mcp Tool Name",
      "type": "string"
    },
    "output_schema": {
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+\\.v(?:0|[1-9][0-9]*)$",
      "title": "Output Schema",
      "type": "string"
    },
    "qualification_status": {
      "const": "development_unqualified",
      "default": "development_unqualified",
      "title": "Qualification Status",
      "type": "string"
    },
    "schema_version": {
      "const": "harness.development_skill_descriptor.v1",
      "default": "harness.development_skill_descriptor.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "skill_id": {
      "pattern": "^[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}$",
      "title": "Skill Id",
      "type": "string"
    },
    "version": {
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "skill_id",
    "version",
    "mcp_tool_name",
    "input_schema",
    "output_schema",
    "implementation_sha256"
  ],
  "title": "DevelopmentSkillDescriptor",
  "type": "object"
}
