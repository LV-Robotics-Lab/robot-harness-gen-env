{
  "$defs": {
    "AssetDebtEntry": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[a-z][a-z0-9_]{0,127}$",
          "title": "Asset Id",
          "type": "string"
        },
        "ledger_bytes": {
          "minimum": 1,
          "title": "Ledger Bytes",
          "type": "integer"
        },
        "ledger_path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$",
          "title": "Ledger Path",
          "type": "string"
        },
        "ledger_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ledger Sha256",
          "type": "string"
        },
        "recovery_probes": {
          "items": {
            "$ref": "#/$defs/RepresentationRecoveryProbe"
          },
          "minItems": 1,
          "title": "Recovery Probes",
          "type": "array"
        },
        "source_cohort": {
          "$ref": "#/$defs/SourceCohort"
        },
        "violation_counts": {
          "items": {
            "$ref": "#/$defs/DebtViolationCount"
          },
          "minItems": 1,
          "title": "Violation Counts",
          "type": "array"
        }
      },
      "required": [
        "asset_id",
        "source_cohort",
        "ledger_path",
        "ledger_sha256",
        "ledger_bytes",
        "violation_counts",
        "recovery_probes"
      ],
      "title": "AssetDebtEntry",
      "type": "object"
    },
    "DebtViolationCount": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Code",
          "type": "string"
        },
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "count"
      ],
      "title": "DebtViolationCount",
      "type": "object"
    },
    "InventoryScope": {
      "enum": [
        "structural_tracer",
        "full_baseline"
      ],
      "title": "InventoryScope",
      "type": "string"
    },
    "ProbeAvailability": {
      "enum": [
        "available",
        "missing"
      ],
      "title": "ProbeAvailability",
      "type": "string"
    },
    "RepresentationRecoveryProbe": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/ProbeAvailability"
        },
        "declared_bytes": {
          "minimum": 1,
          "title": "Declared Bytes",
          "type": "integer"
        },
        "declared_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Declared Sha256",
          "type": "string"
        },
        "logical_path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$",
          "title": "Logical Path",
          "type": "string"
        },
        "model_id": {
          "minimum": 0,
          "title": "Model Id",
          "type": "integer"
        },
        "observed_bytes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Bytes"
        },
        "observed_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Sha256"
        },
        "role": {
          "$ref": "#/$defs/RepresentationRole"
        }
      },
      "required": [
        "model_id",
        "role",
        "logical_path",
        "declared_sha256",
        "declared_bytes",
        "availability",
        "observed_sha256",
        "observed_bytes"
      ],
      "title": "RepresentationRecoveryProbe",
      "type": "object"
    },
    "RepresentationRole": {
      "enum": [
        "collision",
        "visual"
      ],
      "title": "RepresentationRole",
      "type": "string"
    },
    "SourceCohort": {
      "enum": [
        "upstream",
        "historical_asset_library"
      ],
      "title": "SourceCohort",
      "type": "string"
    }
  },
  "$id": "harness.asset_debt_inventory.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "byte_probe_revision": {
      "const": null,
      "title": "Byte Probe Revision",
      "type": "null"
    },
    "byte_probe_source": {
      "const": "local_unversioned_robotwin_assets",
      "title": "Byte Probe Source",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/AssetDebtEntry"
      },
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    },
    "inventory_id": {
      "pattern": "^[a-z][a-z0-9_]{0,127}$",
      "title": "Inventory Id",
      "type": "string"
    },
    "schema_version": {
      "const": "harness.asset_debt_inventory.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/InventoryScope"
    },
    "source_ledger_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Ledger Commit",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "inventory_id",
    "scope",
    "source_ledger_commit",
    "byte_probe_source",
    "byte_probe_revision",
    "entries"
  ],
  "title": "AssetDebtInventory",
  "type": "object"
}
