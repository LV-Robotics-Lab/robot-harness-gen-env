{
  "$defs": {
    "ArtifactRef": {
      "$id": "harness.artifact_ref.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "harness.workflow_start_receipt.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable head receipt for parent workflow creation.",
  "properties": {
    "principal_id": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Principal Id",
      "type": "string"
    },
    "registry_snapshot": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "requested_profile": {
      "maxLength": 255,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+@(?:0|[1-9][0-9]*)$",
      "title": "Requested Profile",
      "type": "string"
    },
    "schema_version": {
      "const": "harness.workflow_start_receipt.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "state_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "State Sha256",
      "type": "string"
    },
    "workflow_run_id": {
      "format": "uuid",
      "title": "Workflow Run Id",
      "type": "string"
    },
    "workspace": {
      "enum": [
        "ephemeral",
        "production"
      ],
      "title": "Workspace",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "workflow_run_id",
    "principal_id",
    "workspace",
    "requested_profile",
    "request_sha256",
    "state_sha256",
    "state_ref",
    "registry_snapshot",
    "started_at"
  ],
  "title": "WorkflowStartReceipt",
  "type": "object"
}
