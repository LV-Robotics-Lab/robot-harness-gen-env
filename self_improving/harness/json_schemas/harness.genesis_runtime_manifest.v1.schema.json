{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "RuntimeManifestMemberV1": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "path": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "root": {
          "enum": [
            "backend",
            "distributions",
            "genesis",
            "interpreter",
            "native",
            "stdlib"
          ],
          "title": "Root",
          "type": "string"
        }
      },
      "required": [
        "root",
        "path",
        "artifact"
      ],
      "title": "RuntimeManifestMemberV1",
      "type": "object"
    },
    "RuntimeProcessIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "abi": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Abi",
          "type": "string"
        },
        "environment": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Environment",
          "type": "array"
        },
        "implementation": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Implementation",
          "type": "string"
        },
        "platform": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "version": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "implementation",
        "version",
        "abi",
        "platform",
        "environment"
      ],
      "title": "RuntimeProcessIdentityV1",
      "type": "object"
    }
  },
  "$id": "harness.genesis_runtime_manifest.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "const": "declared_byte_closure_only",
      "title": "Authority",
      "type": "string"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/RuntimeManifestMemberV1"
      },
      "minItems": 6,
      "title": "Members",
      "type": "array"
    },
    "process_identity": {
      "$ref": "#/$defs/RuntimeProcessIdentityV1"
    },
    "schema_version": {
      "const": "harness.genesis_runtime_manifest.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "authority",
    "process_identity",
    "members"
  ],
  "title": "GenesisRuntimeManifestV1",
  "type": "object"
}
