{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "harness.image_source_media.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_image": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "color_mode": {
      "enum": [
        "RGB",
        "RGBA",
        "L"
      ],
      "title": "Color Mode",
      "type": "string"
    },
    "decoded_frame_count": {
      "const": 1,
      "title": "Decoded Frame Count",
      "type": "integer"
    },
    "height": {
      "minimum": 1,
      "title": "Height",
      "type": "integer"
    },
    "probe": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "const": "harness.image_source_media.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "source_media_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Media Sha256",
      "type": "string"
    },
    "unique_frame_count": {
      "const": 1,
      "title": "Unique Frame Count",
      "type": "integer"
    },
    "width": {
      "minimum": 1,
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "source_media_sha256",
    "source",
    "canonical_image",
    "probe",
    "width",
    "height",
    "color_mode",
    "decoded_frame_count",
    "unique_frame_count"
  ],
  "title": "ImageSourceMedia",
  "type": "object"
}
