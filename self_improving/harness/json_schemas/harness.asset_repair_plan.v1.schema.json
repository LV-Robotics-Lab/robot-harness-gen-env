{
  "$defs": {
    "ArtifactRef": {
      "$id": "harness.artifact_ref.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AssetRepairDispositionCounts": {
      "additionalProperties": false,
      "properties": {
        "hash_mismatch_new_identity_or_retire": {
          "minimum": 0,
          "title": "Hash Mismatch New Identity Or Retire",
          "type": "integer"
        },
        "observed_primary_digest_match": {
          "minimum": 0,
          "title": "Observed Primary Digest Match",
          "type": "integer"
        },
        "observed_primary_digest_match_remeasure_size": {
          "minimum": 0,
          "title": "Observed Primary Digest Match Remeasure Size",
          "type": "integer"
        },
        "source_missing_new_identity_or_retire": {
          "minimum": 0,
          "title": "Source Missing New Identity Or Retire",
          "type": "integer"
        }
      },
      "required": [
        "observed_primary_digest_match",
        "observed_primary_digest_match_remeasure_size",
        "hash_mismatch_new_identity_or_retire",
        "source_missing_new_identity_or_retire"
      ],
      "title": "AssetRepairDispositionCounts",
      "type": "object"
    },
    "AssetRepairEntryPlan": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[a-z][a-z0-9_]{0,127}$",
          "title": "Asset Id",
          "type": "string"
        },
        "ledger_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ledger Sha256",
          "type": "string"
        },
        "next_step": {
          "$ref": "#/$defs/AssetRepairNextStep"
        },
        "representations": {
          "items": {
            "$ref": "#/$defs/RepresentationRepairPlan"
          },
          "minItems": 1,
          "title": "Representations",
          "type": "array"
        },
        "required_followup": {
          "items": {
            "enum": [
              "enumerate_loader_closure",
              "stage_and_rehash_bytes",
              "qualify_collision_provenance",
              "qualify_genesis_runtime",
              "qualify_settle"
            ],
            "type": "string"
          },
          "title": "Required Followup",
          "type": "array"
        },
        "violation_count": {
          "minimum": 1,
          "title": "Violation Count",
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "ledger_sha256",
        "violation_count",
        "representations",
        "next_step",
        "required_followup"
      ],
      "title": "AssetRepairEntryPlan",
      "type": "object"
    },
    "AssetRepairNextStep": {
      "enum": [
        "stage_and_rehash_observed_primary",
        "stage_and_rehash_observed_primary_remeasure_size",
        "build_new_identity_or_retire_asset"
      ],
      "title": "AssetRepairNextStep",
      "type": "string"
    },
    "InventoryScope": {
      "enum": [
        "structural_tracer",
        "full_baseline"
      ],
      "title": "InventoryScope",
      "type": "string"
    },
    "RepairDisposition": {
      "enum": [
        "observed_primary_digest_match",
        "observed_primary_digest_match_remeasure_size",
        "hash_mismatch_new_identity_or_retire",
        "source_missing_new_identity_or_retire"
      ],
      "title": "RepairDisposition",
      "type": "string"
    },
    "RepresentationRepairPlan": {
      "additionalProperties": false,
      "properties": {
        "declared_bytes": {
          "minimum": 1,
          "title": "Declared Bytes",
          "type": "integer"
        },
        "declared_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Declared Sha256",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/RepairDisposition"
        },
        "logical_path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$",
          "title": "Logical Path",
          "type": "string"
        },
        "model_id": {
          "minimum": 0,
          "title": "Model Id",
          "type": "integer"
        },
        "observed_bytes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Bytes"
        },
        "observed_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Sha256"
        },
        "role": {
          "$ref": "#/$defs/RepresentationRole"
        }
      },
      "required": [
        "model_id",
        "role",
        "logical_path",
        "declared_sha256",
        "declared_bytes",
        "observed_sha256",
        "observed_bytes",
        "disposition"
      ],
      "title": "RepresentationRepairPlan",
      "type": "object"
    },
    "RepresentationRole": {
      "enum": [
        "collision",
        "visual"
      ],
      "title": "RepresentationRole",
      "type": "string"
    }
  },
  "$id": "harness.asset_repair_plan.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "disposition_counts": {
      "$ref": "#/$defs/AssetRepairDispositionCounts"
    },
    "full_baseline_evaluated": {
      "title": "Full Baseline Evaluated",
      "type": "boolean"
    },
    "inventory_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "properties": {
            "media_type": {
              "const": "application/json"
            },
            "schema_version": {
              "const": "harness.asset_debt_inventory.v1"
            },
            "uri": {
              "maxLength": 82,
              "minLength": 82,
              "pattern": "^artifact://sha256/[0-9a-f]{64}$"
            }
          },
          "type": "object"
        }
      ]
    },
    "inventory_scope": {
      "$ref": "#/$defs/InventoryScope"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/AssetRepairEntryPlan"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "planned_ledger_count": {
      "minimum": 1,
      "title": "Planned Ledger Count",
      "type": "integer"
    },
    "planned_representation_count": {
      "minimum": 1,
      "title": "Planned Representation Count",
      "type": "integer"
    },
    "planned_violation_count": {
      "minimum": 1,
      "title": "Planned Violation Count",
      "type": "integer"
    },
    "probe_bytes_in_cas": {
      "const": false,
      "title": "Probe Bytes In Cas",
      "type": "boolean"
    },
    "runtime_qualification_executed": {
      "const": false,
      "title": "Runtime Qualification Executed",
      "type": "boolean"
    },
    "schema_version": {
      "const": "harness.asset_repair_plan.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_asset_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Selected Asset Ids",
      "type": "array"
    },
    "writes_performed": {
      "const": false,
      "title": "Writes Performed",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "inventory_ref",
    "inventory_scope",
    "selected_asset_ids",
    "planned_ledger_count",
    "planned_violation_count",
    "planned_representation_count",
    "disposition_counts",
    "items",
    "full_baseline_evaluated",
    "probe_bytes_in_cas",
    "runtime_qualification_executed",
    "writes_performed"
  ],
  "title": "AssetRepairPlan",
  "type": "object"
}
