{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "harness.development_skill_execution.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "descriptor": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "development_context": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "evidence_policy_id": {
      "title": "Evidence Policy Id",
      "type": "string"
    },
    "evidence_policy_implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Policy Implementation Sha256",
      "type": "string"
    },
    "evidence_policy_version": {
      "title": "Evidence Policy Version",
      "type": "string"
    },
    "implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Implementation Sha256",
      "type": "string"
    },
    "input_schema": {
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+\\.v(?:0|[1-9][0-9]*)$",
      "title": "Input Schema",
      "type": "string"
    },
    "max_attempts": {
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "output_schema": {
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+\\.v(?:0|[1-9][0-9]*)$",
      "title": "Output Schema",
      "type": "string"
    },
    "qualification_status": {
      "const": "development_unqualified",
      "default": "development_unqualified",
      "title": "Qualification Status",
      "type": "string"
    },
    "schema_version": {
      "const": "harness.development_skill_execution.v1",
      "default": "harness.development_skill_execution.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "skill_ref": {
      "pattern": "^[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "title": "Skill Ref",
      "type": "string"
    }
  },
  "required": [
    "skill_ref",
    "descriptor",
    "input_schema",
    "output_schema",
    "implementation_sha256",
    "max_attempts",
    "evidence_policy_id",
    "evidence_policy_version",
    "evidence_policy_implementation_sha256",
    "development_context"
  ],
  "title": "DevelopmentSkillExecution",
  "type": "object"
}
