{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "RunSnapshot": {
      "additionalProperties": false,
      "description": "Current authoritative head of one parent Golden Workflow.",
      "properties": {
        "active_operation": {
          "anyOf": [
            {
              "format": "uuid4",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active Operation"
        },
        "child_runs": {
          "items": {
            "format": "uuid4",
            "type": "string"
          },
          "title": "Child Runs",
          "type": "array"
        },
        "principal_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Principal Id",
          "type": "string"
        },
        "receipt_head": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "registry_snapshot": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "requested_profile": {
          "maxLength": 255,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+@(?:0|[1-9][0-9]*)$",
          "title": "Requested Profile",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "harness.run_snapshot.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "start_request_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "state_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Sha256",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/WorkflowStatus"
        },
        "turn_seq": {
          "minimum": 0,
          "title": "Turn Seq",
          "type": "integer"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "workflow_run_id": {
          "format": "uuid4",
          "title": "Workflow Run Id",
          "type": "string"
        },
        "workspace": {
          "enum": [
            "ephemeral",
            "production"
          ],
          "title": "Workspace",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "workflow_run_id",
        "principal_id",
        "workspace",
        "requested_profile",
        "revision",
        "status",
        "turn_seq",
        "state_sha256",
        "state_ref",
        "start_request_ref",
        "registry_snapshot",
        "receipt_head",
        "active_operation",
        "child_runs",
        "started_at",
        "updated_at"
      ],
      "title": "RunSnapshot",
      "type": "object"
    },
    "WorkflowStatus": {
      "description": "Lifecycle of one parent Golden Workflow.",
      "enum": [
        "active",
        "waiting_input",
        "promoted",
        "cancelled",
        "failed"
      ],
      "title": "WorkflowStatus",
      "type": "string"
    }
  },
  "$id": "harness.resource_access_receipt.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Server-owned proof that exact verified bytes were placed in a response payload.",
  "properties": {
    "access_id": {
      "format": "uuid4",
      "title": "Access Id",
      "type": "string"
    },
    "delivered_bytes": {
      "minimum": 0,
      "title": "Delivered Bytes",
      "type": "integer"
    },
    "delivered_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Delivered Sha256",
      "type": "string"
    },
    "delivery_scope": {
      "const": "server_response_payload",
      "title": "Delivery Scope",
      "type": "string"
    },
    "model_understanding_claimed": {
      "const": false,
      "title": "Model Understanding Claimed",
      "type": "boolean"
    },
    "observed_snapshot": {
      "$ref": "#/$defs/RunSnapshot"
    },
    "observed_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observed Snapshot Sha256",
      "type": "string"
    },
    "principal_id": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Principal Id",
      "type": "string"
    },
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Sha256",
      "type": "string"
    },
    "representation": {
      "enum": [
        "text_utf8",
        "blob_base64"
      ],
      "title": "Representation",
      "type": "string"
    },
    "resource": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "resource_uri": {
      "title": "Resource Uri",
      "type": "string"
    },
    "schema_version": {
      "const": "harness.resource_access_receipt.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "served_at": {
      "format": "date-time",
      "title": "Served At",
      "type": "string"
    },
    "transport_acknowledged": {
      "const": false,
      "title": "Transport Acknowledged",
      "type": "boolean"
    },
    "workflow_run_id": {
      "format": "uuid4",
      "title": "Workflow Run Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "access_id",
    "principal_id",
    "workflow_run_id",
    "resource_uri",
    "resource",
    "delivered_sha256",
    "delivered_bytes",
    "representation",
    "observed_snapshot",
    "observed_snapshot_sha256",
    "served_at",
    "delivery_scope",
    "transport_acknowledged",
    "model_understanding_claimed",
    "receipt_sha256"
  ],
  "title": "ResourceAccessReceipt",
  "type": "object"
}
