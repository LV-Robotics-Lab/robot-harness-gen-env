{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "NoPromptFallback": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "none",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "NoPromptFallback",
      "type": "object"
    },
    "ReplacePromptPatch": {
      "additionalProperties": false,
      "properties": {
        "base_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Base Text Sha256",
          "type": "string"
        },
        "kind": {
          "const": "full_replace",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "replacement_text": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Replacement Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "base_text_sha256",
        "replacement_text",
        "reason"
      ],
      "title": "ReplacePromptPatch",
      "type": "object"
    },
    "VideoFrameToImageFallback": {
      "additionalProperties": false,
      "properties": {
        "frame_index": {
          "minimum": 0,
          "title": "Frame Index",
          "type": "integer"
        },
        "frame_sequence_manifest": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "kind": {
          "const": "video_frame_to_image",
          "title": "Kind",
          "type": "string"
        },
        "selected_frame": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "source_video": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "kind",
        "source_video",
        "selected_frame",
        "frame_index",
        "frame_sequence_manifest"
      ],
      "title": "VideoFrameToImageFallback",
      "type": "object"
    }
  },
  "$id": "harness.prompt_revision_command.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Request one immutable full-replacement prompt revision.",
  "properties": {
    "advisory_receipt": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "command_id": {
      "format": "uuid4",
      "title": "Command Id",
      "type": "string"
    },
    "expected_receipt_head_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Receipt Head Sha256",
      "type": "string"
    },
    "expected_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected State Sha256",
      "type": "string"
    },
    "expected_workflow_revision": {
      "minimum": 0,
      "title": "Expected Workflow Revision",
      "type": "integer"
    },
    "external_agent_executed": {
      "const": false,
      "title": "External Agent Executed",
      "type": "boolean"
    },
    "failure_receipts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Failure Receipts",
      "type": "array"
    },
    "fallback": {
      "discriminator": {
        "mapping": {
          "none": "#/$defs/NoPromptFallback",
          "video_frame_to_image": "#/$defs/VideoFrameToImageFallback"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NoPromptFallback"
        },
        {
          "$ref": "#/$defs/VideoFrameToImageFallback"
        }
      ],
      "title": "Fallback"
    },
    "idempotency_key": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "next_compile_skill_ref": {
      "pattern": "^[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "title": "Next Compile Skill Ref",
      "type": "string"
    },
    "patch": {
      "$ref": "#/$defs/ReplacePromptPatch"
    },
    "predecessor_package": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "principal_id": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Principal Id",
      "type": "string"
    },
    "schema_version": {
      "const": "harness.prompt_revision_command.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_prompt": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "workflow_run_id": {
      "format": "uuid4",
      "title": "Workflow Run Id",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "principal_id",
    "workflow_run_id",
    "idempotency_key",
    "expected_workflow_revision",
    "expected_state_sha256",
    "expected_receipt_head_sha256",
    "schema_version",
    "source_prompt",
    "advisory_receipt",
    "failure_receipts",
    "predecessor_package",
    "patch",
    "fallback",
    "next_compile_skill_ref",
    "external_agent_executed"
  ],
  "title": "PromptRevisionCommand",
  "type": "object"
}
