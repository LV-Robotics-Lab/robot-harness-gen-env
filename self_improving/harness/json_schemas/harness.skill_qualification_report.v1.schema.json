{
  "$defs": {
    "JsonValue": {},
    "QualificationCheckV1": {
      "additionalProperties": false,
      "description": "One named acceptance gate and its report-bound observed values.",
      "properties": {
        "evidence": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Evidence",
          "type": "object"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "status": {
          "const": "pass",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "evidence"
      ],
      "title": "QualificationCheckV1",
      "type": "object"
    }
  },
  "$id": "harness.skill_qualification_report.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Schema-catalog projection that preserves the qualified record contract.",
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/QualificationCheckV1"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "deterministic_case_id": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Deterministic Case Id",
      "type": "string"
    },
    "implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Implementation Sha256",
      "type": "string"
    },
    "ledger_contract_tree_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ledger Contract Tree Sha256",
      "type": "string"
    },
    "regression_command": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Regression Command",
      "type": "string"
    },
    "scene_gen_tree_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scene Gen Tree Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "harness.skill_qualification_report.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "skill_ref": {
      "pattern": "^[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "title": "Skill Ref",
      "type": "string"
    },
    "status": {
      "const": "pass",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "skill_ref",
    "status",
    "deterministic_case_id",
    "regression_command",
    "implementation_sha256",
    "scene_gen_tree_sha256",
    "ledger_contract_tree_sha256",
    "checks"
  ],
  "title": "PublicQualificationReportV1",
  "type": "object"
}
