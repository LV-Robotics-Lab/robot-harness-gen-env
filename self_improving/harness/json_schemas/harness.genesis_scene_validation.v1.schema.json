{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "harness.genesis_scene_validation.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assessed_at": {
      "format": "date-time",
      "title": "Assessed At",
      "type": "string"
    },
    "candidate_only": {
      "default": false,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "execution_receipt": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "invocation_digest": {
      "title": "Invocation Digest",
      "type": "string"
    },
    "replay": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "replay_run_id": {
      "format": "uuid",
      "title": "Replay Run Id",
      "type": "string"
    },
    "report": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "robot_policy_evaluated": {
      "const": false,
      "title": "Robot Policy Evaluated",
      "type": "boolean"
    },
    "scene": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "const": "harness.genesis_scene_validation.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "genesis.rigid_scene@1",
      "title": "Scope",
      "type": "string"
    },
    "simulator_rerun": {
      "const": false,
      "title": "Simulator Rerun",
      "type": "boolean"
    },
    "status": {
      "const": "passed",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scope",
    "status",
    "replay_run_id",
    "invocation_digest",
    "execution_receipt",
    "scene",
    "replay",
    "report",
    "assessed_at",
    "simulator_rerun",
    "robot_policy_evaluated"
  ],
  "title": "GenesisSceneValidationV1",
  "type": "object"
}
