{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "RuntimeManifestMemberV1": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "path": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "root": {
          "enum": [
            "backend",
            "distributions",
            "genesis",
            "interpreter",
            "native",
            "stdlib"
          ],
          "title": "Root",
          "type": "string"
        }
      },
      "required": [
        "root",
        "path",
        "artifact"
      ],
      "title": "RuntimeManifestMemberV1",
      "type": "object"
    }
  },
  "$id": "harness.genesis_runtime_execution_request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "representation": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "runner": {
      "$ref": "#/$defs/RuntimeManifestMemberV1"
    },
    "runtime_lock": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "const": "harness.genesis_runtime_execution_request.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "manifest",
    "representation",
    "runtime_lock",
    "runner"
  ],
  "title": "GenesisRuntimeExecutionRequestV1",
  "type": "object"
}
