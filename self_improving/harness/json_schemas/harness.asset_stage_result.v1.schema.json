{
  "$defs": {
    "ArtifactRef": {
      "$id": "harness.artifact_ref.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AssetLoaderClosure": {
      "additionalProperties": false,
      "properties": {
        "closure_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Closure Sha256",
          "type": "string"
        },
        "loader_scale": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Loader Scale",
          "type": "array"
        },
        "member_logical_paths": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f\\u2028\\u2029]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f\\u2028\\u2029]+)*$",
            "type": "string"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Member Logical Paths",
          "type": "array"
        },
        "model_id": {
          "minimum": 0,
          "title": "Model Id",
          "type": "integer"
        },
        "model_sidecar_logical_path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f\\u2028\\u2029]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f\\u2028\\u2029]+)*$",
          "title": "Model Sidecar Logical Path",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/RepresentationRole"
        },
        "root_logical_path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f\\u2028\\u2029]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f\\u2028\\u2029]+)*$",
          "title": "Root Logical Path",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "role",
        "root_logical_path",
        "model_sidecar_logical_path",
        "loader_scale",
        "member_logical_paths",
        "closure_sha256"
      ],
      "title": "AssetLoaderClosure",
      "type": "object"
    },
    "RepresentationRole": {
      "enum": [
        "collision",
        "visual"
      ],
      "title": "RepresentationRole",
      "type": "string"
    },
    "StagedAsset": {
      "additionalProperties": false,
      "properties": {
        "asset_closure_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Asset Closure Sha256",
          "type": "string"
        },
        "asset_id": {
          "pattern": "^[a-z][a-z0-9_]{0,127}$",
          "title": "Asset Id",
          "type": "string"
        },
        "loader_closures": {
          "items": {
            "$ref": "#/$defs/AssetLoaderClosure"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Loader Closures",
          "type": "array"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/StagedAssetMember"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Members",
          "type": "array"
        },
        "source_ledger_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Ledger Sha256",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "source_ledger_sha256",
        "members",
        "loader_closures",
        "asset_closure_sha256"
      ],
      "title": "StagedAsset",
      "type": "object"
    },
    "StagedAssetMember": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "logical_path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f\\u2028\\u2029]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f\\u2028\\u2029]+)*$",
          "title": "Logical Path",
          "type": "string"
        },
        "source_bytes": {
          "minimum": 1,
          "title": "Source Bytes",
          "type": "integer"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "logical_path",
        "source_sha256",
        "source_bytes",
        "artifact_ref"
      ],
      "title": "StagedAssetMember",
      "type": "object"
    }
  },
  "$id": "harness.asset_stage_result.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/StagedAsset"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Assets",
      "type": "array"
    },
    "authoritative_ledger_writes_performed": {
      "const": false,
      "title": "Authoritative Ledger Writes Performed",
      "type": "boolean"
    },
    "exact_source_bytes_staged": {
      "const": true,
      "title": "Exact Source Bytes Staged",
      "type": "boolean"
    },
    "inventory_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "properties": {
            "media_type": {
              "const": "application/json"
            },
            "schema_version": {
              "const": "harness.asset_debt_inventory.v1"
            },
            "uri": {
              "maxLength": 82,
              "minLength": 82,
              "pattern": "^artifact://sha256/[0-9a-f]{64}$"
            }
          },
          "type": "object"
        }
      ]
    },
    "loader_closure_enumerated": {
      "const": true,
      "title": "Loader Closure Enumerated",
      "type": "boolean"
    },
    "promotion_executed": {
      "const": false,
      "title": "Promotion Executed",
      "type": "boolean"
    },
    "repair_plan_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "properties": {
            "media_type": {
              "const": "application/json"
            },
            "schema_version": {
              "const": "harness.asset_repair_plan.v1"
            },
            "uri": {
              "maxLength": 82,
              "minLength": 82,
              "pattern": "^artifact://sha256/[0-9a-f]{64}$"
            }
          },
          "type": "object"
        }
      ]
    },
    "runtime_qualification_executed": {
      "const": false,
      "title": "Runtime Qualification Executed",
      "type": "boolean"
    },
    "schema_version": {
      "const": "harness.asset_stage_result.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_asset_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{0,127}$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Selected Asset Ids",
      "type": "array"
    },
    "simulator_executed": {
      "const": false,
      "title": "Simulator Executed",
      "type": "boolean"
    },
    "source_snapshot_manifest_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "properties": {
            "media_type": {
              "const": "application/json"
            },
            "schema_version": {
              "const": "harness.asset_source_snapshot_manifest.v1"
            },
            "uri": {
              "maxLength": 82,
              "minLength": 82,
              "pattern": "^artifact://sha256/[0-9a-f]{64}$"
            }
          },
          "type": "object"
        }
      ]
    },
    "stage_binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Stage Binding Sha256",
      "type": "string"
    },
    "staged_asset_count": {
      "minimum": 1,
      "title": "Staged Asset Count",
      "type": "integer"
    },
    "staged_member_count": {
      "minimum": 1,
      "title": "Staged Member Count",
      "type": "integer"
    },
    "staged_total_bytes": {
      "minimum": 1,
      "title": "Staged Total Bytes",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "inventory_ref",
    "repair_plan_ref",
    "source_snapshot_manifest_ref",
    "selected_asset_ids",
    "staged_asset_count",
    "staged_member_count",
    "staged_total_bytes",
    "assets",
    "stage_binding_sha256",
    "exact_source_bytes_staged",
    "loader_closure_enumerated",
    "simulator_executed",
    "runtime_qualification_executed",
    "promotion_executed",
    "authoritative_ledger_writes_performed"
  ],
  "title": "AssetStageResult",
  "type": "object"
}
