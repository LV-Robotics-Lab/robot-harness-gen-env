{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "harness.prompt_revision_compile_attempt.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A compile that must consume one immutable prompt-revision control receipt.",
  "properties": {
    "effective_prompt": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "failure_receipts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Failure Receipts",
      "type": "array"
    },
    "kind": {
      "const": "prompt_revision",
      "title": "Kind",
      "type": "string"
    },
    "predecessor_package": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "prompt_revision": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "const": "harness.prompt_revision_compile_attempt.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "prompt_revision",
    "effective_prompt",
    "failure_receipts",
    "predecessor_package"
  ],
  "title": "PromptRevisionCompileAttemptV1",
  "type": "object"
}
