{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "DevelopmentCheckV1": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "name": {
          "enum": [
            "input_output_hash_binding",
            "exact_skill_qualification",
            "workflow_receipt_closure",
            "physical_validation",
            "media_closure",
            "codex_attempt_journal",
            "development_source_capture",
            "clean_release_tree",
            "formal_preview_library_admission",
            "formal_preview_publication"
          ],
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "executed",
            "omitted"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "detail",
        "evidence"
      ],
      "title": "DevelopmentCheckV1",
      "type": "object"
    },
    "DevelopmentEnvironmentVariableV1": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "CUDA_VISIBLE_DEVICES",
            "GENESIS_BACKEND",
            "MKL_NUM_THREADS",
            "OMP_NUM_THREADS",
            "OPENBLAS_NUM_THREADS",
            "PYTHONHASHSEED",
            "PYTHONPATH"
          ],
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "DevelopmentEnvironmentVariableV1",
      "type": "object"
    },
    "DevelopmentExecutionEnvironmentV1": {
      "additionalProperties": false,
      "properties": {
        "platform": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "python_abi": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Python Abi",
          "type": "string"
        },
        "python_executable": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Python Executable",
          "type": "string"
        },
        "python_executable_bytes": {
          "minimum": 0,
          "title": "Python Executable Bytes",
          "type": "integer"
        },
        "python_executable_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Python Executable Sha256",
          "type": "string"
        },
        "python_implementation": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Python Implementation",
          "type": "string"
        },
        "python_version": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Python Version",
          "type": "string"
        },
        "variables": {
          "items": {
            "$ref": "#/$defs/DevelopmentEnvironmentVariableV1"
          },
          "title": "Variables",
          "type": "array"
        }
      },
      "required": [
        "python_executable",
        "python_executable_sha256",
        "python_executable_bytes",
        "python_implementation",
        "python_version",
        "python_abi",
        "platform",
        "variables"
      ],
      "title": "DevelopmentExecutionEnvironmentV1",
      "type": "object"
    },
    "DevelopmentGitSourceIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Commit",
          "type": "string"
        },
        "dirty": {
          "title": "Dirty",
          "type": "boolean"
        },
        "repository_locator": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Repository Locator",
          "type": "string"
        },
        "tracked_diff_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tracked Diff Sha256",
          "type": "string"
        },
        "tree_state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tree State Sha256",
          "type": "string"
        },
        "untracked_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Untracked Manifest Sha256",
          "type": "string"
        }
      },
      "required": [
        "repository_locator",
        "commit",
        "dirty",
        "tracked_diff_sha256",
        "untracked_manifest_sha256",
        "tree_state_sha256"
      ],
      "title": "DevelopmentGitSourceIdentityV1",
      "type": "object"
    }
  },
  "$id": "harness.development_execution_record.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Debug package: inspectable evidence without release or qualification authority.",
  "properties": {
    "changed_exact_skill_closure_allowed": {
      "const": false,
      "title": "Changed Exact Skill Closure Allowed",
      "type": "boolean"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/DevelopmentCheckV1"
      },
      "title": "Checks",
      "type": "array"
    },
    "configuration": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "development_context": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "environment": {
      "$ref": "#/$defs/DevelopmentExecutionEnvironmentV1"
    },
    "exact_skills_qualified": {
      "const": true,
      "title": "Exact Skills Qualified",
      "type": "boolean"
    },
    "execution_mode": {
      "const": "development",
      "title": "Execution Mode",
      "type": "string"
    },
    "formal_library_written": {
      "const": false,
      "title": "Formal Library Written",
      "type": "boolean"
    },
    "idempotency_key": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "input_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Input Artifacts",
      "type": "array"
    },
    "log_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Log Artifacts",
      "type": "array"
    },
    "output_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Output Artifacts",
      "type": "array"
    },
    "physical_evidence": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Physical Evidence",
      "type": "array"
    },
    "principal_id": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Principal Id",
      "type": "string"
    },
    "qualification_status": {
      "const": "development_unqualified",
      "title": "Qualification Status",
      "type": "string"
    },
    "record_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "const": "harness.development_execution_record.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_identity": {
      "$ref": "#/$defs/DevelopmentGitSourceIdentityV1"
    },
    "workflow_head": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "workflow_run_id": {
      "format": "uuid4",
      "title": "Workflow Run Id",
      "type": "string"
    },
    "workspace": {
      "const": "ephemeral",
      "title": "Workspace",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "workflow_run_id",
    "principal_id",
    "idempotency_key",
    "workspace",
    "execution_mode",
    "qualification_status",
    "exact_skills_qualified",
    "changed_exact_skill_closure_allowed",
    "formal_library_written",
    "workflow_head",
    "development_context",
    "source_identity",
    "environment",
    "configuration",
    "input_artifacts",
    "output_artifacts",
    "log_artifacts",
    "physical_evidence",
    "checks",
    "created_at"
  ],
  "title": "DevelopmentExecutionRecordV1",
  "type": "object"
}
