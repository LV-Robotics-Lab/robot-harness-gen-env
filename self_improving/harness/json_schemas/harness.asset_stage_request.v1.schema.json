{
  "$defs": {
    "ArtifactRef": {
      "$id": "harness.artifact_ref.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$id": "harness.asset_stage_request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "inventory_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "properties": {
            "media_type": {
              "const": "application/json"
            },
            "schema_version": {
              "const": "harness.asset_debt_inventory.v1"
            },
            "uri": {
              "maxLength": 82,
              "minLength": 82,
              "pattern": "^artifact://sha256/[0-9a-f]{64}$"
            }
          },
          "type": "object"
        }
      ]
    },
    "repair_plan_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "properties": {
            "media_type": {
              "const": "application/json"
            },
            "schema_version": {
              "const": "harness.asset_repair_plan.v1"
            },
            "uri": {
              "maxLength": 82,
              "minLength": 82,
              "pattern": "^artifact://sha256/[0-9a-f]{64}$"
            }
          },
          "type": "object"
        }
      ]
    },
    "schema_version": {
      "const": "harness.asset_stage_request.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_snapshot_manifest_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "properties": {
            "media_type": {
              "const": "application/json"
            },
            "schema_version": {
              "const": "harness.asset_source_snapshot_manifest.v1"
            },
            "uri": {
              "maxLength": 82,
              "minLength": 82,
              "pattern": "^artifact://sha256/[0-9a-f]{64}$"
            }
          },
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "inventory_ref",
    "repair_plan_ref",
    "source_snapshot_manifest_ref"
  ],
  "title": "AssetStageRequest",
  "type": "object"
}
