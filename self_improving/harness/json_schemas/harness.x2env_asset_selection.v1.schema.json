{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AssetModelSubjectV1": {
      "additionalProperties": false,
      "properties": {
        "asset_key": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$",
          "title": "Asset Key",
          "type": "string"
        },
        "backend": {
          "const": "genesis",
          "title": "Backend",
          "type": "string"
        },
        "ledger_asset_id": {
          "pattern": "^[a-z0-9][a-z0-9_]{0,127}$",
          "title": "Ledger Asset Id",
          "type": "string"
        },
        "model_id": {
          "minimum": 0,
          "title": "Model Id",
          "type": "integer"
        },
        "namespace": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Namespace",
          "type": "string"
        },
        "source_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Record Sha256",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "asset_key",
        "ledger_asset_id",
        "model_id",
        "backend",
        "source_record_sha256"
      ],
      "title": "AssetModelSubjectV1",
      "type": "object"
    },
    "QualifiedAssetSubjectV1": {
      "additionalProperties": false,
      "properties": {
        "loader_closure_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Loader Closure Sha256",
          "type": "string"
        },
        "model_subject": {
          "$ref": "#/$defs/AssetModelSubjectV1"
        },
        "representation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Representation Sha256",
          "type": "string"
        }
      },
      "required": [
        "model_subject",
        "representation_sha256",
        "loader_closure_sha256"
      ],
      "title": "QualifiedAssetSubjectV1",
      "type": "object"
    }
  },
  "$id": "harness.x2env_asset_selection.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset_catalog": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "asset_closure_manifest": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "catalog_subject": {
      "$ref": "#/$defs/AssetModelSubjectV1"
    },
    "decision_reason": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Decision Reason",
      "type": "string"
    },
    "lane": {
      "const": "exact_asset_reuse",
      "title": "Lane",
      "type": "string"
    },
    "qualification": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "qualified_subject": {
      "$ref": "#/$defs/QualifiedAssetSubjectV1"
    },
    "representation": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "scene_object_id": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Scene Object Id",
      "type": "string"
    },
    "schema_version": {
      "const": "harness.x2env_asset_selection.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selected": {
      "const": true,
      "title": "Selected",
      "type": "boolean"
    },
    "selection_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "selection_sha256",
    "scene_object_id",
    "lane",
    "asset_catalog",
    "catalog_subject",
    "qualified_subject",
    "representation",
    "qualification",
    "asset_closure_manifest",
    "selected",
    "decision_reason"
  ],
  "title": "X2EnvAssetSelectionV1",
  "type": "object"
}
