{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Blocker": {
      "additionalProperties": false,
      "properties": {
        "artifact_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "stage": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        },
        "unknowns": {
          "items": {
            "$ref": "#/$defs/UnknownField"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message",
        "stage",
        "retryable",
        "details",
        "unknowns",
        "artifact_refs"
      ],
      "title": "Blocker",
      "type": "object"
    },
    "DependencyRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "title": "DependencyRef",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "artifact_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "attempt": {
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "from_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "stage": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "to_status": {
          "$ref": "#/$defs/RunStatus"
        }
      },
      "required": [
        "seq",
        "timestamp",
        "stage",
        "attempt",
        "from_status",
        "to_status",
        "artifact_refs"
      ],
      "title": "Event",
      "type": "object"
    },
    "Invocation": {
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "items": {
            "$ref": "#/$defs/DependencyRef"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "effective_parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Effective Parameters",
          "type": "object"
        },
        "invocation_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Invocation Digest",
          "type": "string"
        },
        "max_attempts": {
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "run_id": {
          "format": "uuid4",
          "title": "Run Id",
          "type": "string"
        },
        "skill_id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}$",
          "title": "Skill Id",
          "type": "string"
        },
        "skill_version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Skill Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "skill_id",
        "skill_version",
        "effective_parameters",
        "dependencies",
        "max_attempts",
        "invocation_digest"
      ],
      "title": "Invocation",
      "type": "object"
    },
    "JsonValue": {},
    "QualificationCandidateIntentV1": {
      "additionalProperties": false,
      "description": "A qualification candidate's immutable invocation, terminal, and typed output.",
      "properties": {
        "invocation": {
          "$ref": "#/$defs/Invocation"
        },
        "invocation_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Invocation Digest",
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "run_id": {
          "format": "uuid4",
          "title": "Run Id",
          "type": "string"
        },
        "run_state": {
          "$ref": "#/$defs/RunState"
        }
      },
      "required": [
        "run_id",
        "invocation_digest",
        "invocation",
        "run_state",
        "output"
      ],
      "title": "QualificationCandidateIntentV1",
      "type": "object"
    },
    "QualificationImplementationMemberV1": {
      "additionalProperties": false,
      "description": "One portable implementation member whose bytes live in CAS.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "logical_path": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Logical Path",
          "type": "string"
        }
      },
      "required": [
        "logical_path",
        "artifact"
      ],
      "title": "QualificationImplementationMemberV1",
      "type": "object"
    },
    "RunState": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "attempt": {
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "blocker": {
          "anyOf": [
            {
              "$ref": "#/$defs/Blocker"
            },
            {
              "type": "null"
            }
          ]
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ended At"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "minItems": 1,
          "title": "Events",
          "type": "array"
        },
        "invocation_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Invocation Digest"
        },
        "max_attempts": {
          "minimum": 0,
          "title": "Max Attempts",
          "type": "integer"
        },
        "output": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output"
        },
        "run_id": {
          "format": "uuid4",
          "title": "Run Id",
          "type": "string"
        },
        "skill_id": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Skill Id",
          "type": "string"
        },
        "skill_version": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Skill Version",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        }
      },
      "required": [
        "run_id",
        "invocation_digest",
        "skill_id",
        "skill_version",
        "status",
        "attempt",
        "max_attempts",
        "started_at",
        "ended_at",
        "events",
        "artifacts",
        "output",
        "blocker"
      ],
      "title": "RunState",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "running",
        "succeeded",
        "blocked",
        "failed"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "UnknownField": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "reason": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "source": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "field",
        "reason",
        "source"
      ],
      "title": "UnknownField",
      "type": "object"
    }
  },
  "$id": "harness.typed_qualification_admission.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Frozen native qualification evidence accepted without generic translation.",
  "properties": {
    "admission_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Admission Sha256",
      "type": "string"
    },
    "candidate_intents": {
      "items": {
        "$ref": "#/$defs/QualificationCandidateIntentV1"
      },
      "minItems": 1,
      "title": "Candidate Intents",
      "type": "array"
    },
    "descriptor": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "implementation_members": {
      "items": {
        "$ref": "#/$defs/QualificationImplementationMemberV1"
      },
      "minItems": 1,
      "title": "Implementation Members",
      "type": "array"
    },
    "implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Implementation Sha256",
      "type": "string"
    },
    "mcp_tool_name": {
      "pattern": "^[a-z][a-z0-9_]{0,127}$",
      "title": "Mcp Tool Name",
      "type": "string"
    },
    "qualification": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "qualification_report": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "const": "harness.typed_qualification_admission.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "skill_ref": {
      "pattern": "^[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "title": "Skill Ref",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "skill_ref",
    "mcp_tool_name",
    "descriptor",
    "qualification",
    "qualification_report",
    "implementation_sha256",
    "implementation_members",
    "candidate_intents",
    "admission_sha256"
  ],
  "title": "TypedQualificationAdmissionV1",
  "type": "object"
}
