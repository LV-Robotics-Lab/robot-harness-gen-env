{
  "$defs": {
    "ArtifactRef": {
      "$id": "harness.artifact_ref.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Version"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "media_type",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ImageSourceMedia": {
      "$id": "harness.image_source_media.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "canonical_image": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "color_mode": {
          "enum": [
            "RGB",
            "RGBA",
            "L"
          ],
          "title": "Color Mode",
          "type": "string"
        },
        "decoded_frame_count": {
          "const": 1,
          "title": "Decoded Frame Count",
          "type": "integer"
        },
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "probe": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "schema_version": {
          "const": "harness.image_source_media.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "source_media_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Media Sha256",
          "type": "string"
        },
        "unique_frame_count": {
          "const": 1,
          "title": "Unique Frame Count",
          "type": "integer"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "source_media_sha256",
        "source",
        "canonical_image",
        "probe",
        "width",
        "height",
        "color_mode",
        "decoded_frame_count",
        "unique_frame_count"
      ],
      "title": "ImageSourceMedia",
      "type": "object"
    },
    "RepresentationOrigin": {
      "enum": [
        "harness_native",
        "legacy_genenv_adapted"
      ],
      "title": "RepresentationOrigin",
      "type": "string"
    },
    "RequestedGenesisProfile": {
      "enum": [
        "genesis.rigid_scene@1",
        "genesis.robot_policy@1"
      ],
      "title": "RequestedGenesisProfile",
      "type": "string"
    },
    "VideoSourceMedia": {
      "$id": "harness.video_source_media.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "decoded_frame_count": {
          "minimum": 1,
          "title": "Decoded Frame Count",
          "type": "integer"
        },
        "duration_ms": {
          "minimum": 1,
          "title": "Duration Ms",
          "type": "integer"
        },
        "fps_denominator": {
          "minimum": 1,
          "title": "Fps Denominator",
          "type": "integer"
        },
        "fps_numerator": {
          "minimum": 1,
          "title": "Fps Numerator",
          "type": "integer"
        },
        "frame_sequence_manifest": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "frame_sequence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Frame Sequence Sha256",
          "type": "string"
        },
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "probe": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "schema_version": {
          "const": "harness.video_source_media.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "source_media_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Media Sha256",
          "type": "string"
        },
        "unique_frame_count": {
          "minimum": 1,
          "title": "Unique Frame Count",
          "type": "integer"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "source_media_sha256",
        "source",
        "probe",
        "frame_sequence_manifest",
        "width",
        "height",
        "duration_ms",
        "fps_numerator",
        "fps_denominator",
        "decoded_frame_count",
        "unique_frame_count",
        "frame_sequence_sha256"
      ],
      "title": "VideoSourceMedia",
      "type": "object"
    },
    "X2EnvEnvironmentPackage": {
      "$id": "harness.x2env_environment_package.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "asset_closure_manifest": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "backend": {
          "const": "genesis",
          "title": "Backend",
          "type": "string"
        },
        "binding_manifest": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "collision_qualified": {
          "const": false,
          "default": false,
          "title": "Collision Qualified",
          "type": "boolean"
        },
        "environment_format": {
          "const": "harness.genesis_portable.v1",
          "title": "Environment Format",
          "type": "string"
        },
        "legacy_adapter_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "package_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Package Id",
          "type": "string"
        },
        "producer_skill_ref": {
          "pattern": "^[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Producer Skill Ref",
          "type": "string"
        },
        "representation_origin": {
          "$ref": "#/$defs/RepresentationOrigin"
        },
        "requested_profile": {
          "$ref": "#/$defs/RequestedGenesisProfile"
        },
        "route_id": {
          "enum": [
            "image2env",
            "video2env"
          ],
          "title": "Route Id",
          "type": "string"
        },
        "runtime_lock": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "scene_ir": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "schema_version": {
          "const": "harness.x2env_environment_package.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "simulator_ready": {
          "const": false,
          "default": false,
          "title": "Simulator Ready",
          "type": "boolean"
        },
        "source_media": {
          "discriminator": {
            "mapping": {
              "harness.image_source_media.v1": "#/$defs/ImageSourceMedia",
              "harness.video_source_media.v1": "#/$defs/VideoSourceMedia"
            },
            "propertyName": "schema_version"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ImageSourceMedia"
            },
            {
              "$ref": "#/$defs/VideoSourceMedia"
            }
          ],
          "title": "Source Media"
        },
        "task_ir": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "schema_version",
        "package_id",
        "route_id",
        "producer_skill_ref",
        "source_media",
        "requested_profile",
        "environment_format",
        "backend",
        "representation_origin",
        "legacy_adapter_receipt",
        "scene_ir",
        "task_ir",
        "asset_closure_manifest",
        "binding_manifest",
        "runtime_lock"
      ],
      "title": "X2EnvEnvironmentPackage",
      "type": "object"
    }
  },
  "$id": "harness.video2env_replay_output.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "collisions_enabled": {
      "const": true,
      "title": "Collisions Enabled",
      "type": "boolean"
    },
    "environment_package": {
      "$ref": "#/$defs/X2EnvEnvironmentPackage"
    },
    "frame_sequence_manifest": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "fresh_observation_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Fresh Observation Refs",
      "type": "array"
    },
    "media_verification": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "package_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Package Id",
      "type": "string"
    },
    "physics_report": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "requested_profile": {
      "$ref": "#/$defs/RequestedGenesisProfile"
    },
    "robot_probe_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime_evidence": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "runtime_receipt": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "const": "harness.video2env_replay_output.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "simulator_executed": {
      "const": true,
      "title": "Simulator Executed",
      "type": "boolean"
    },
    "steps_executed": {
      "minimum": 1,
      "title": "Steps Executed",
      "type": "integer"
    },
    "total_frame_count": {
      "minimum": 1,
      "title": "Total Frame Count",
      "type": "integer"
    },
    "trajectory": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "unique_frame_count": {
      "minimum": 1,
      "title": "Unique Frame Count",
      "type": "integer"
    },
    "video": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "environment_package",
    "package_id",
    "requested_profile",
    "runtime_evidence",
    "physics_report",
    "robot_probe_report",
    "trajectory",
    "video",
    "frame_sequence_manifest",
    "media_verification",
    "runtime_receipt",
    "fresh_observation_refs",
    "steps_executed",
    "total_frame_count",
    "unique_frame_count",
    "collisions_enabled",
    "simulator_executed",
    "schema_version"
  ],
  "title": "Video2EnvReplayOutput",
  "type": "object"
}
