{
  "additionalProperties": false,
  "properties": {
    "frame": {
      "description": "Exactly 'world' or another entity's id; never invent frame aliases. Structural supports use world.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z][\\w-]*$",
      "title": "Frame",
      "type": "string"
    },
    "position": {
      "description": "Intent x/y/z in metres in the declared frame. Use null for each unknown axis, including unresolved support height; do not invent coordinates.",
      "items": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Position",
      "type": "array"
    },
    "yaw_degrees": {
      "anyOf": [
        {
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Yaw Degrees"
    }
  },
  "required": [
    "frame",
    "position",
    "yaw_degrees"
  ],
  "title": "Pose",
  "type": "object"
}
