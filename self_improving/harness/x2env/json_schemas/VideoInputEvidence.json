    "time_base_den": {
      "exclusiveMinimum": 0,
      "title": "Time Base Den",
      "type": "integer"
    },
    "time_base_num": {
      "exclusiveMinimum": 0,
      "title": "Time Base Num",
      "type": "integer"
    },
    "unique_frame_count": {
      "exclusiveMinimum": 0,
      "title": "Unique Frame Count",
      "type": "integer"
    },
    "width": {
      "exclusiveMinimum": 0,
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "source",
    "probe",
    "sequence",
    "width",
    "height",
    "codec",
    "fps_num",
    "fps_den",
    "time_base_num",
