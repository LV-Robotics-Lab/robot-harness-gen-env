        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "codec": {
      "minLength": 1,
      "title": "Codec",
      "type": "string"
    },
    "decoder_version": {
      "minLength": 1,
      "title": "Decoder Version",
      "type": "string"
    },
    "fps_den": {
      "exclusiveMinimum": 0,
      "title": "Fps Den",
      "type": "integer"
    },
    "fps_num": {
      "exclusiveMinimum": 0,
      "title": "Fps Num",
      "type": "integer"
    },
    "frame_count": {
      "exclusiveMinimum": 0,
      "title": "Frame Count",
      "type": "integer"
    },
    "height": {
      "exclusiveMinimum": 0,
      "title": "Height",
      "type": "integer"
    },
    "pixel_format": {
      "const": "rgb24",
      "default": "rgb24",
      "title": "Pixel Format",
      "type": "string"
    },
    "probe": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "sequence": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "source": {
