{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alchedata.local/schemas/openxsim_command_registry.schema.json",
  "title": "PEARL Open X Sim Command Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "command_count",
    "commands",
    "owner_split",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "alchedata.openxsim_command_registry.v1"
    },
    "status": {
      "const": "pass_six_command_contracts"
    },
    "command_count": {
      "const": 6
    },
    "commands": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "owner_split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Zheng Ye", "Gaochen", "Boris"],
      "properties": {
        "Zheng Ye": { "$ref": "#/$defs/non_empty_strings" },
        "Gaochen": { "$ref": "#/$defs/non_empty_strings" },
        "Boris": { "$ref": "#/$defs/non_empty_strings" }
      }
    },
    "claim_boundary": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "owner",
        "support_owner",
        "inputs",
        "outputs",
        "artifact_paths",
        "failure_codes",
        "current_evidence",
        "claim_boundary"
      ],
      "properties": {
        "command": {
          "enum": [
            "/gen-env",
            "/collect",
            "/train",
            "/evaluate",
            "/diagnose",
            "/transfer"
          ]
        },
        "owner": { "$ref": "#/$defs/non_empty_string" },
        "support_owner": { "$ref": "#/$defs/non_empty_string" },
        "inputs": { "$ref": "#/$defs/non_empty_strings" },
        "outputs": { "$ref": "#/$defs/non_empty_strings" },
        "artifact_paths": { "$ref": "#/$defs/non_empty_strings" },
        "failure_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          }
        },
        "current_evidence": { "$ref": "#/$defs/non_empty_strings" },
        "claim_boundary": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
