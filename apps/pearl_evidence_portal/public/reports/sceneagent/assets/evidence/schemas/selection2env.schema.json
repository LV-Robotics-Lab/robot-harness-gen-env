{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alchedata.local/schemas/selection2env.schema.json",
  "title": "Selection2Env Artifact",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "task_text",
    "status",
    "scene_id",
    "catalog_sources",
    "asset_candidates",
    "selected_assets",
    "placement_regions",
    "support_surface",
    "pose_constraints",
    "camera_observation",
    "robot_constraints",
    "success_verifier",
    "artifacts",
    "blockers",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "const": "alchedata.selection2env.v0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_text": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pass_static_only",
        "ready_for_sim_smoke",
        "pass_sim_smoke",
        "unsupported_blocker",
        "fail"
      ]
    },
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "source_pipeline_status": {
      "type": "string"
    },
    "catalog_sources": {
      "type": "object",
      "required": ["robotwin", "agenticsim", "articraft10k"],
      "additionalProperties": {
        "type": "object",
        "required": ["entry_count", "selection_eligible_count", "match_count"],
        "properties": {
          "entry_count": {"type": "integer", "minimum": 0},
          "selection_eligible_count": {"type": "integer", "minimum": 0},
          "match_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "asset_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "semantic_name",
          "catalog_source",
          "backend_asset_id",
          "execution_status",
          "selection_eligible",
          "decision",
          "reason"
        ],
        "properties": {
          "asset_id": {"type": "string"},
          "semantic_name": {"type": "string"},
          "catalog_source": {"type": "string"},
          "backend_asset_id": {"type": "string"},
          "execution_status": {"type": "string"},
          "selection_eligible": {"type": "boolean"},
          "decision": {"enum": ["accepted", "rejected", "missing"]},
          "reason": {"type": "string"}
        }
      }
    },
    "selected_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object_id", "asset_id", "model_id", "role"],
        "properties": {
          "object_id": {"type": "string"},
          "asset_id": {"type": "string"},
          "model_id": {"type": "integer"},
          "role": {"type": "string"},
          "semantic": {"type": "string"}
        }
      }
    },
    "placement_regions": {
      "type": "object"
    },
    "support_surface": {
      "type": "object",
      "required": ["type", "frame", "bounds"],
      "properties": {
        "type": {"type": "string"},
        "frame": {"type": "string"},
        "bounds": {"type": "object"}
      }
    },
    "pose_constraints": {
      "type": "array",
      "items": {"type": "object"}
    },
    "camera_observation": {
      "type": "object",
      "required": ["required_views", "visual_checks"],
      "properties": {
        "required_views": {"type": "array", "items": {"type": "string"}},
        "visual_checks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "robot_constraints": {
      "type": "object",
      "required": ["embodiment", "workspace_reachability", "action_interface"],
      "properties": {
        "embodiment": {"type": "string"},
        "workspace_reachability": {"type": "string"},
        "action_interface": {"type": "string"}
      }
    },
    "success_verifier": {
      "type": "object",
      "required": ["type", "conditions", "failure_modes"],
      "properties": {
        "type": {"type": "string"},
        "conditions": {"type": "array", "items": {"type": "string"}},
        "failure_modes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "artifacts": {
      "type": "object"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "owner"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"},
          "owner": {"type": "string"}
        }
      }
    },
    "handoff": {
      "type": "object",
      "required": ["collect_outputs", "train_reads", "evaluate_reads"],
      "properties": {
        "collect_outputs": {"type": "array", "items": {"type": "string"}},
        "train_reads": {"type": "array", "items": {"type": "string"}},
        "evaluate_reads": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
