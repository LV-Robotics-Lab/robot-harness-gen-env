# Python / local runtime
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# Large generated robotics data
*.hdf5
*.h5
data/
datasets/
outputs/
checkpoints/
logs/
wandb/
install_logs/
.cache/
runs/
artifacts/

# RoboTwin / simulator heavy assets
assets/
/external/RoboTwin/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.agents/

# Local generated scene experiments are reproducible run outputs.
generated/

# Self-improving platform source is first-class. Only local environments,
# generated runs, rendered media, downloaded assets, and credentials stay out.
self_improving/**/.venv/
self_improving/**/__pycache__/
self_improving/**/.pytest_cache/
self_improving/**/runs/
self_improving/**/results/
self_improving/**/datasets/
self_improving/**/checkpoints/
self_improving/**/logs/
self_improving/**/wandb/
self_improving/**/assets/
self_improving/**/data/
self_improving/**/*.mp4
self_improving/**/*.tar
self_improving/**/*.tar.gz
self_improving/**/*.glb
self_improving/**/*.usd
self_improving/**/*.usda
self_improving/**/.env
self_improving/**/local_config.py
self_improving/alchedata/report_sources/

# Hours-long measured metadata is small and must remain recoverable. Keep the
# rest of the asset-pipeline data tree ignored.
!self_improving/asset_pipeline/active/data/
self_improving/asset_pipeline/active/data/*
!self_improving/asset_pipeline/active/data/scene_gen_ext/
self_improving/asset_pipeline/active/data/scene_gen_ext/*
!self_improving/asset_pipeline/active/data/scene_gen_ext/native_origin_calibration.json
!self_improving/asset_pipeline/active/data/scene_gen_ext/top_support_survey.json
!self_improving/asset_pipeline/active/data/scene_gen_ext/asset_attributes.json
!self_improving/asset_pipeline/active/data/scene_gen_ext/runtime_revocations.json

# Curated, test-bound structured fixtures retained from Alchedata. Bulk runs
# remain ignored; only the named placement seed is versioned.
!self_improving/alchedata/artifacts/
!self_improving/alchedata/artifacts/**
!self_improving/alchedata/runs/
self_improving/alchedata/runs/*
!self_improving/alchedata/runs/probe_static_apple_plate_action_repair/
!self_improving/alchedata/runs/probe_static_apple_plate_action_repair/final_placement.json
# 账本是唯一权威入库记录，必须有 git 历史（spec §3.9；2026-08-14 事故中
# 17 份在 git 的账本是資產池唯一幸存的部分，例外规则随迁移带到本仓库）
!self_improving/asset_pipeline/active/data/asset_library/
self_improving/asset_pipeline/active/data/asset_library/*
!self_improving/asset_pipeline/active/data/asset_library/README.md
!self_improving/asset_pipeline/active/data/asset_library/*/
self_improving/asset_pipeline/active/data/asset_library/*/*
!self_improving/asset_pipeline/active/data/asset_library/*/ledger.json
# 库按来源分层后账本深了一级（<provider>/<asset>/ledger.json）。上面那组
# 规则只放行到 */ledger.json；不补下面三行，65 份账本会在搬迁的瞬间静默
# 掉出版本控制——而账本正是 2026-08-14 事故里唯一幸存的东西。
!self_improving/asset_pipeline/active/data/asset_library/*/*/
self_improving/asset_pipeline/active/data/asset_library/*/*/*
!self_improving/asset_pipeline/active/data/asset_library/*/*/ledger.json
!self_improving/asset_pipeline/active/data/upstream_ledgers/
self_improving/asset_pipeline/active/data/upstream_ledgers/*
!self_improving/asset_pipeline/active/data/upstream_ledgers/*/
self_improving/asset_pipeline/active/data/upstream_ledgers/*/*
!self_improving/asset_pipeline/active/data/upstream_ledgers/*/ledger.json
