# 外部只读依赖：不入 git，clone 后自建软链（见 README）
/external/

# 运行产物 / 大文件 / 缓存：靠 README + stats 追溯，不提交
/data/*
# 运行产物一律不入 git。原先只写 /results/（锚定仓库根），于是
# <阶段目录>/results/ 会漏网——2026-08-10 值夜时 1_asset_reuse/results/
# 的 41MB 测试产物就是这么被 git add -A 收进去的。去掉前导斜杠，任意
# 层级的 results/ 都忽略。
results/
/work/
/runs/
/out/

# asset ledger 是唯一权威入库记录，必须有 git 历史（spec §3.9 治理注记）
!/data/asset_library/
data/asset_library/*
!data/asset_library/*/
data/asset_library/*/*
!data/asset_library/*/ledger.json

# openxsim vendored 依赖（约 5.8M，见 shared/openxsim/UPSTREAM.md）
shared/openxsim/third_party/
shared/openxsim/deps/

# Python 缓存 / 构建
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# 环境 / 密钥
.env
*.local

# macOS AppleDouble / DS_Store
._*
.DS_Store

# upstream asset ledgers -- same exemption cascade as asset_library ledgers
!/data/upstream_ledgers/
/data/upstream_ledgers/*
!/data/upstream_ledgers/*/
/data/upstream_ledgers/*/*
!/data/upstream_ledgers/*/ledger.json

# 实测元数据必须有 git 历史（2026-08-14 事故注记）：这些 JSON 只有几百 KB，
# 但每一份都是数小时 GPU 实测的产物（原点校准 430 条、顶面/内腔探针、颜色
# 属性 508 个模型）。当天 /home/jingxiang/yuxin 被整体清空 530GB 时，代码
# 因为在 GitHub 上毫发无伤，这些测量却全部蒸发——同样的东西不该再丢第二次。
!/data/scene_gen_ext/
data/scene_gen_ext/*
!data/scene_gen_ext/native_origin_calibration.json
!data/scene_gen_ext/top_support_survey.json
!data/scene_gen_ext/asset_attributes.json
!data/scene_gen_ext/runtime_revocations.json
