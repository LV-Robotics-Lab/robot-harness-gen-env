# Python / local runtime
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# Large generated robotics data
*.hdf5
*.h5
data/
local_data/
datasets/
outputs/
checkpoints/
logs/
wandb/
install_logs/
.cache/
runs/
artifacts/

# RoboTwin / simulator heavy assets
assets/

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Local generated scene experiments are reproducible run outputs.
generated/

# Self-improving platform source is first-class. Only local environments,
# generated runs, rendered media, downloaded assets, and credentials stay out.
self_improving/**/.venv/
self_improving/**/__pycache__/
self_improving/**/.pytest_cache/
self_improving/**/runs/
self_improving/**/results/
self_improving/**/datasets/
self_improving/**/checkpoints/
self_improving/**/logs/
self_improving/**/wandb/
self_improving/**/assets/
self_improving/**/data/
self_improving/**/*.mp4
self_improving/**/*.tar
self_improving/**/*.tar.gz
self_improving/**/*.glb
self_improving/**/*.usd
self_improving/**/*.usda
self_improving/**/.env
self_improving/**/local_config.py
self_improving/alchedata/report_sources/

# Curated, test-bound structured fixtures retained from Alchedata. Bulk runs
# remain ignored; only the named placement seed is versioned.
!self_improving/alchedata/artifacts/
!self_improving/alchedata/artifacts/**
!self_improving/alchedata/runs/
self_improving/alchedata/runs/*
!self_improving/alchedata/runs/probe_static_apple_plate_action_repair/
!self_improving/alchedata/runs/probe_static_apple_plate_action_repair/final_placement.json
