+++ b/tests/test_catalog_sources.py
@@ -0,0 +1,98 @@
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from generate_scene.asset_grounding import ground_assets
+from generate_scene.catalog_sources import (
+    augment_robotwin_catalog_with_agenticsim_aliases,
+    build_candidate_search,
+)
+
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+
+
+def read_json(path: Path) -> dict:
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def test_agenticsim_aliases_enter_grounding_only_with_robotwin_backend() -> None:
+    robotwin = {
+        "catalog_version": "test",
+        "entries": [
+            {"asset_id": "071_can", "semantic_name": "can", "aliases": ["can"], "tags": []},
+            {"asset_id": "110_basket", "semantic_name": "basket", "aliases": ["basket"], "tags": []},
+        ],
+    }
+    agenticsim = read_json(REPO_ROOT / "asset_catalogs" / "agenticsim_placement_assets.json")
+
+    execution_catalog = augment_robotwin_catalog_with_agenticsim_aliases(robotwin, agenticsim)
+    grounding = ground_assets(
+        prompt="place the cola can into the basket",
+        master_catalog=execution_catalog,
+        master_catalog_path="robotwin.json",
+    )
+
+    assert grounding["selected_asset_ids"] == ["071_can", "110_basket"]
+    can = next(entry for entry in execution_catalog["entries"] if entry["asset_id"] == "071_can")
+    assert "cola can" in can["aliases"]
+    assert can["alias_sources"][0]["source"] == "agenticsim"
+
+
+def test_catalog_search_keeps_articraft_catalog_only() -> None:
+    robotwin = {
+        "catalog_version": "test",
+        "entries": [
+            {"asset_id": "036_cabinet", "semantic_name": "cabinet", "aliases": ["cabinet"], "tags": []}
+        ],
+    }
+    agenticsim = read_json(REPO_ROOT / "asset_catalogs" / "agenticsim_placement_assets.json")
+    articraft = {
+        "schema_version": "alchedata.articraft10k_manifest.v0",
+        "dataset": "camvsl/Articraft-10K",
+        "entries": [
+            {
+                "asset_id": "rec_drawer_1",
+                "semantic_text": "small tabletop drawer",
+                "semantic_tokens": ["small", "tabletop", "drawer"],
+                "source_path": "rec_drawer_1.tar.gz",
+                "download_url": "https://example.invalid/rec_drawer_1.tar.gz",
+                "asset_format_in_archive": "URDF",
+                "import_status": "catalog_only_not_imported",
+            }
+        ],
+    }
+
+    report = build_candidate_search(
+        prompt="open the drawer",
+        robotwin_catalog=robotwin,
+        robotwin_catalog_path="robotwin.json",
+        agenticsim_catalog=agenticsim,
+        agenticsim_catalog_path="agenticsim.json",
+        articraft_manifest=articraft,
+        articraft_manifest_path="articraft.json",
+    )
+
+    by_source = {match["catalog_source"]: match for match in report["matches"]}
+    assert by_source["agenticsim"]["backend_asset_id"] == "036_cabinet"
+    assert by_source["agenticsim"]["selection_eligible"] is True
+    assert by_source["articraft10k"]["execution_status"] == "catalog_only_not_imported"
+    assert by_source["articraft10k"]["selection_eligible"] is False
+
+
+def test_missing_agenticsim_backend_stays_blocked() -> None:
+    robotwin = {"catalog_version": "test", "entries": []}
+    agenticsim = read_json(REPO_ROOT / "asset_catalogs" / "agenticsim_placement_assets.json")
+
+    report = build_candidate_search(
+        prompt="place the cola can",
+        robotwin_catalog=robotwin,
+        robotwin_catalog_path="robotwin.json",
+        agenticsim_catalog=agenticsim,
+        agenticsim_catalog_path="agenticsim.json",
+    )
+
+    match = next(item for item in report["matches"] if item["catalog_source"] == "agenticsim")
+    assert match["execution_status"] == "blocked_missing_robotwin_backend"
+    assert match["selection_eligible"] is False
