diff --git a/generate_scene/catalog_sources.py b/generate_scene/catalog_sources.py
new file mode 100644
index 0000000..71d3711
--- /dev/null
+++ b/generate_scene/catalog_sources.py
@@ -0,0 +1,329 @@
+#!/usr/bin/env python3
+"""Normalize and search selection2env asset catalog sources.
+
+RoboTwin remains the execution catalog. AgenticSim contributes aliases for
+RoboTwin-backed assets, while Articraft contributes searchable candidates that
+stay ineligible until an import/probe gate promotes them.
+"""
+
+from __future__ import annotations
+
+import argparse
+import copy
+import re
+import sys
+from pathlib import Path
+from typing import Any
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(REPO_ROOT))
+
+from generate_scene.schemas import read_json, write_json
+
+
+STOP_TERMS = {
+    "a",
+    "an",
+    "and",
+    "from",
+    "in",
+    "inside",
+    "into",
+    "of",
+    "on",
+    "place",
+    "put",
+    "the",
+    "to",
+}
+
+
+def _norm(value: str) -> str:
+    return re.sub(r"\s+", " ", str(value).lower().replace("_", " ").replace("-", " ")).strip()
+
+
+def _tokens(value: str) -> set[str]:
+    return {
+        token
+        for token in re.findall(r"[a-z0-9]+", _norm(value))
+        if len(token) > 1 and token not in STOP_TERMS
+    }
+
+
+def _contains_term(text: str, term: str) -> bool:
+    pattern = r"(?<![a-z0-9])" + re.escape(term) + r"(?![a-z0-9])"
+    return re.search(pattern, text) is not None
+
+
+def _unique_strings(values: list[Any]) -> list[str]:
+    result: list[str] = []
+    for value in values:
+        item = str(value or "").strip()
+        if item and item not in result:
+            result.append(item)
+    return result
+
+
+def normalize_robotwin_catalog(catalog: dict[str, Any], *, source_path: str) -> list[dict[str, Any]]:
+    candidates: list[dict[str, Any]] = []
+    for entry in catalog.get("entries", []):
+        asset_id = str(entry["asset_id"])
+        semantic_name = str(entry.get("semantic_name") or asset_id)
+        candidates.append(
+            {
+                "candidate_id": f"robotwin:{asset_id}",
+                "catalog_source": "robotwin",
+                "asset_id": asset_id,
+                "backend_asset_id": asset_id,
+                "semantic_name": semantic_name,
+                "aliases": _unique_strings([semantic_name, *entry.get("aliases", [])]),
+                "tags": _unique_strings(entry.get("tags", [])),
+                "asset_format": "RoboTwin object directory",
+                "execution_status": "robotwin_loadable",
+                "selection_eligible": True,
+                "provenance": {
+                    "catalog_path": source_path,
+                    "catalog_version": catalog.get("catalog_version"),
+                    "discovery": entry.get("discovery"),
+                },
+            }
+        )
+    return candidates
+
+
+def normalize_agenticsim_catalog(
+    catalog: dict[str, Any],
+    *,
+    source_path: str,
+    robotwin_asset_ids: set[str],
+) -> list[dict[str, Any]]:
+    candidates: list[dict[str, Any]] = []
+    source = catalog.get("source", {})
+    for entry in catalog.get("entries", []):
+        backend_asset_id = str(entry["backend_asset_id"])
+        semantic_name = str(entry.get("semantic_name") or backend_asset_id)
+        backend_available = backend_asset_id in robotwin_asset_ids
+        candidates.append(
+            {
+                "candidate_id": f"agenticsim:{backend_asset_id}",
+                "catalog_source": "agenticsim",
+                "asset_id": backend_asset_id,
+                "backend_asset_id": backend_asset_id,
+                "semantic_name": semantic_name,
+                "aliases": _unique_strings([semantic_name, *entry.get("aliases", [])]),
+                "tags": _unique_strings(entry.get("tags", [])),
+                "asset_format": "AgenticSim alias -> RoboTwin object directory",
+                "execution_status": (
+                    "robotwin_alias_loadable" if backend_available else "blocked_missing_robotwin_backend"
+                ),
+                "selection_eligible": backend_available,
+                "model_ids": entry.get("model_ids", []),
+                "provenance": {
+                    "catalog_path": source_path,
+                    "catalog_version": catalog.get("catalog_version"),
+                    "source_project": source.get("project"),
+                    "source_commit": source.get("source_commit"),
+                    "source_file": source.get("source_file"),
+                },
+            }
+        )
+    return candidates
+
+
+def normalize_articraft_manifest(manifest: dict[str, Any], *, source_path: str) -> list[dict[str, Any]]:
+    candidates: list[dict[str, Any]] = []
+    for entry in manifest.get("entries", []):
+        asset_id = str(entry["asset_id"])
+        semantic_name = str(entry.get("semantic_text") or asset_id)
+        candidates.append(
+            {
+                "candidate_id": f"articraft10k:{asset_id}",
+                "catalog_source": "articraft10k",
+                "asset_id": asset_id,
+                "backend_asset_id": None,
+                "semantic_name": semantic_name,
+                "aliases": [semantic_name],
+                "tags": _unique_strings(entry.get("semantic_tokens", [])),
+                "asset_format": str(entry.get("asset_format_in_archive") or "URDF"),
+                "execution_status": str(entry.get("import_status") or "catalog_only_not_imported"),
+                "selection_eligible": False,
+                "provenance": {
+                    "catalog_path": source_path,
+                    "dataset": manifest.get("dataset"),
+                    "source_path": entry.get("source_path"),
+                    "download_url": entry.get("download_url"),
+                },
+            }
+        )
+    return candidates
+
+
+def augment_robotwin_catalog_with_agenticsim_aliases(
+    robotwin_catalog: dict[str, Any],
+    agenticsim_catalog: dict[str, Any] | None,
+) -> dict[str, Any]:
+    """Merge only AgenticSim aliases backed by a RoboTwin catalog entry."""
+
+    result = copy.deepcopy(robotwin_catalog)
+    if not agenticsim_catalog:
+        return result
+
+    entries = {str(entry["asset_id"]): entry for entry in result.get("entries", [])}
+    for alias_entry in agenticsim_catalog.get("entries", []):
+        backend_asset_id = str(alias_entry["backend_asset_id"])
+        target = entries.get(backend_asset_id)
+        if target is None:
+            continue
+        target["aliases"] = _unique_strings(
+            [
+                *target.get("aliases", []),
+                alias_entry.get("semantic_name", ""),
+                *alias_entry.get("aliases", []),
+            ]
+        )
+        alias_sources = target.setdefault("alias_sources", [])
+        source_record = {
+            "source": "agenticsim",
+            "catalog_version": agenticsim_catalog.get("catalog_version"),
+            "source_commit": agenticsim_catalog.get("source", {}).get("source_commit"),
+        }
+        if source_record not in alias_sources:
+            alias_sources.append(source_record)
+    return result
+
+
+def _match_score(prompt: str, candidate: dict[str, Any]) -> tuple[int, list[str]]:
+    prompt_norm = _norm(prompt)
+    prompt_tokens = _tokens(prompt_norm)
+    terms = _unique_strings(
+        [candidate.get("semantic_name", ""), *candidate.get("aliases", []), *candidate.get("tags", [])]
+    )
+    matched_terms: list[str] = []
+    score = 0
+    for raw_term in terms:
+        term = _norm(raw_term)
+        if not term:
+            continue
+        if _contains_term(prompt_norm, term):
+            matched_terms.append(raw_term)
+            score = max(score, 1000 + 100 * len(_tokens(term)) + len(term))
+    candidate_tokens: set[str] = set()
+    for term in terms:
+        candidate_tokens.update(_tokens(term))
+    overlap = prompt_tokens.intersection(candidate_tokens)
+    if overlap:
+        score += len(overlap) * 25
+        matched_terms.extend(sorted(overlap))
+    return score, _unique_strings(matched_terms)
+
+
+def build_candidate_search(
+    *,
+    prompt: str,
+    robotwin_catalog: dict[str, Any],
+    robotwin_catalog_path: str,
+    agenticsim_catalog: dict[str, Any] | None = None,
+    agenticsim_catalog_path: str | None = None,
+    articraft_manifest: dict[str, Any] | None = None,
+    articraft_manifest_path: str | None = None,
+    limit_per_source: int = 8,
+) -> dict[str, Any]:
+    robotwin_ids = {str(entry["asset_id"]) for entry in robotwin_catalog.get("entries", [])}
+    candidates = normalize_robotwin_catalog(robotwin_catalog, source_path=robotwin_catalog_path)
+    if agenticsim_catalog:
+        candidates.extend(
+            normalize_agenticsim_catalog(
+                agenticsim_catalog,
+                source_path=agenticsim_catalog_path or "agenticsim_catalog",
+                robotwin_asset_ids=robotwin_ids,
+            )
+        )
+    if articraft_manifest:
+        candidates.extend(
+            normalize_articraft_manifest(
+                articraft_manifest,
+                source_path=articraft_manifest_path or "articraft_manifest",
+            )
+        )
+
+    source_stats: dict[str, dict[str, int]] = {}
+    ranked_by_source: dict[str, list[dict[str, Any]]] = {}
+    for candidate in candidates:
+        source = str(candidate["catalog_source"])
+        stats = source_stats.setdefault(source, {"entry_count": 0, "selection_eligible_count": 0, "match_count": 0})
+        stats["entry_count"] += 1
+        if candidate["selection_eligible"]:
+            stats["selection_eligible_count"] += 1
+        score, matched_terms = _match_score(prompt, candidate)
+        if score <= 0:
+            continue
+        stats["match_count"] += 1
+        ranked_by_source.setdefault(source, []).append(
+            {**candidate, "match_score": score, "matched_terms": matched_terms}
+        )
+
+    matches: list[dict[str, Any]] = []
+    for source in sorted(ranked_by_source):
+        ranked = sorted(
+            ranked_by_source[source],
+            key=lambda item: (-int(item["match_score"]), str(item["candidate_id"])),
+        )
+        matches.extend(ranked[: max(1, limit_per_source)])
+
+    return {
+        "schema_version": "robotwin.selection2env_catalog_search.v0",
+        "prompt": prompt,
+        "source_stats": source_stats,
+        "match_count_returned": len(matches),
+        "selection_rule": (
+            "Only selection_eligible candidates may enter RoboTwin scene generation; catalog-only candidates remain blockers."
+        ),
+        "matches": matches,
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description="Search RoboTwin, AgenticSim, and Articraft selection2env catalogs.")
+    parser.add_argument("--prompt", required=True)
+    parser.add_argument("--robotwin-catalog", required=True)
+    parser.add_argument("--agenticsim-catalog")
+    parser.add_argument("--articraft-manifest")
+    parser.add_argument("--limit-per-source", type=int, default=8)
+    parser.add_argument("--out", required=True)
+    parser.add_argument("--execution-catalog-out")
+    args = parser.parse_args()
+
+    robotwin_path = Path(args.robotwin_catalog)
+    robotwin_catalog = read_json(robotwin_path)
+    agenticsim_path = Path(args.agenticsim_catalog) if args.agenticsim_catalog else None
+    agenticsim_catalog = read_json(agenticsim_path) if agenticsim_path else None
+    articraft_path = Path(args.articraft_manifest) if args.articraft_manifest else None
+    articraft_manifest = read_json(articraft_path) if articraft_path else None
+
+    report = build_candidate_search(
+        prompt=args.prompt,
+        robotwin_catalog=robotwin_catalog,
+        robotwin_catalog_path=str(robotwin_path),
+        agenticsim_catalog=agenticsim_catalog,
+        agenticsim_catalog_path=str(agenticsim_path) if agenticsim_path else None,
+        articraft_manifest=articraft_manifest,
+        articraft_manifest_path=str(articraft_path) if articraft_path else None,
+        limit_per_source=args.limit_per_source,
+    )
+    write_json(Path(args.out), report)
+    if args.execution_catalog_out:
+        execution_catalog = augment_robotwin_catalog_with_agenticsim_aliases(robotwin_catalog, agenticsim_catalog)
+        write_json(Path(args.execution_catalog_out), execution_catalog)
+    print(
+        "PASS "
+        + " ".join(
+            f"{source}={stats['entry_count']}" for source, stats in sorted(report["source_stats"].items())
+        )
+        + f" matches={report['match_count_returned']}"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
